# -----------------------------------------------------------------------------
# Aura Stream API — Environment Configuration
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL / Supabase) ---
# Option A: Local Docker PostgreSQL
DATABASE_URL=postgresql://aura:aura_password@localhost:5432/aura

# Option B: Supabase Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Redis Cache & Distributed Rate Limiter ---
REDIS_URL=redis://localhost:6379

# --- Authentication & JWT ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Server & CORS ---
PORT=4000
FRONTEND_URL=http://localhost:5173
