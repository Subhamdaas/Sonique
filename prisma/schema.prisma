datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

enum UserRole {
  LISTENER
  ARTIST
  PODCAST_CREATOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
  FAMILY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  username     String?    @unique
  avatarUrl    String?
  role         UserRole   @default(LISTENER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tracks          Track[]            @relation("UploadedTracks")
  playlists       Playlist[]
  refreshTokens   RefreshToken[]
  likedTracks     Like[]
  history         ListeningHistory[]
  subscriptions   Subscription[]
  following       Follow[]           @relation("UserFollowing")
  followers       Follow[]           @relation("UserFollowers")
  podcastShows    PodcastShow[]
  playbackState   PlaybackState?

  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Artist {
  id        String   @id @default(cuid())
  name      String   @unique
  bio       String?
  imageUrl  String?
  verified  Boolean  @default(false)
  genres    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums    Album[]
  tracks    Track[]

  @@index([name])
}

model Album {
  id          String   @id @default(cuid())
  title       String
  artistId    String
  releaseYear Int?
  coverUrl    String?
  genre       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]

  @@index([title])
  @@index([artistId])
}

model Track {
  id           String   @id @default(cuid())
  title        String
  artist       String
  artistId     String?
  album        String?
  albumId      String?
  duration     Int
  audioUrl     String
  coverUrl     String?
  genre        String?
  plays        Int      @default(0)
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy     User               @relation("UploadedTracks", fields: [uploadedById], references: [id], onDelete: Cascade)
  artistRef      Artist?            @relation(fields: [artistId], references: [id], onDelete: SetNull)
  albumRef       Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  likes          Like[]
  playlistTracks PlaylistTrack[]
  history        ListeningHistory[]

  @@index([title])
  @@index([artist])
  @@index([uploadedById])
  @@index([artistId])
  @@index([albumId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model Playlist {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(true)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([ownerId])
  @@index([createdAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model ListeningHistory {
  id             String   @id @default(cuid())
  userId         String
  trackId        String
  playedAt       DateTime @default(now())
  durationPlayed Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([trackId])
}

model PodcastShow {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  author      String
  category    String?
  creatorId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User?            @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  episodes    PodcastEpisode[]

  @@index([title])
  @@index([category])
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  showId      String
  title       String
  description String?
  audioUrl    String
  coverUrl    String?
  duration    Int
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  show PodcastShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([publishedAt])
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  tier             SubscriptionTier @default(FREE)
  isActive         Boolean          @default(true)
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model PlaybackState {
  id              String   @id @default(cuid())
  userId          String   @unique
  trackId         String?
  positionSeconds Float    @default(0)
  queue           Json?    @default("[]")
  queueIndex      Int      @default(0)
  volume          Float    @default(0.8)
  isMuted         Boolean  @default(false)
  shuffle         Boolean  @default(false)
  repeatMode      String   @default("off")
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}