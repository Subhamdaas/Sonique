# -----------------------------------------------------------------------------
# Sonique API — Environment Configuration
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL / Supabase) ---
# Option A: Local Docker PostgreSQL
DATABASE_URL=postgresql://sonique:sonique_password@localhost:5432/sonique

# Option B: Supabase Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Direct (Migrations): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Cloud Services (Server-side ONLY — NEVER EXPOSE TO FRONTEND) ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=sonique-media

# --- Redis Cache & Distributed Rate Limiter ---
REDIS_URL=redis://localhost:6379

# --- Authentication & JWT ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Server & CORS ---
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
